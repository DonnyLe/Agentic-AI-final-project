# Copy to .env (local dev) and to .env.prod (deployed database), then fill in.
# Both are gitignored; never commit real values. Commands read .env by default;
# prefix with KANGAROO_ENV=prod to use .env.prod, e.g.
#   KANGAROO_ENV=prod uv run alembic upgrade head
# On Render, set the same variables in the service's environment settings.

# --- LLMs (any OpenAI-compatible endpoint; OpenRouter by default) ----------
LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Model per agent role, as the provider's model ID. Roles left blank use
# KANGAROO_MODEL_DEFAULT. Example: nvidia/nemotron-3.5-lightning:free
KANGAROO_MODEL_DEFAULT=
KANGAROO_MODEL_INTAKE=
KANGAROO_MODEL_SUPERVISOR=
KANGAROO_MODEL_EVIDENCE=
KANGAROO_MODEL_ADJUDICATOR=

# --- Database ---------------------------------------------------------------
# .env: the local Postgres from compose.yaml (`docker compose up -d`).
# .env.prod: the Neon connection string from the Neon dashboard,
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://kangaroo:kangaroo@localhost:5432/kangaroo

# --- App ------------------------------------------------------------------
# Optional shared token for the reviewer UI and /api/*. Leave blank to
# disable (local dev).
KANGAROO_ACCESS_TOKEN=
